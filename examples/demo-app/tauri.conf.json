  "productName": "MCP Demo",
  "version": "0.1.0",
  "identifier": "dev.tauri-plugin-mcp-server.demo",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
